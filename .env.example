# Emrooz environment variables.
# All variables are optional; when they are missing, the app runs in local demo mode
# (bundled seed data, no external providers, no Supabase).
#
# Legend:
#   [public]     safe to expose in browser and mobile bundles
#   [server]     server-only, never send to browser or mobile
#   [dev-only]   fine for local development, never use in production

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=                    # [public]  e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # [public]  anon/public JWT
SUPABASE_SERVICE_ROLE_KEY=                   # [server]  DO NOT COMMIT. Never load in browser/mobile.

# ---- Recipe providers ----
THEMEALDB_API_KEY=1                          # [server]  "1" is the public dev test key. Requires paid key before app-store release.
SPOONACULAR_API_KEY=                         # [server]  optional; see licensing rules in docs/recipe-sourcing-and-licensing.md
EDAMAM_APP_ID=                               # [server]  optional
EDAMAM_APP_KEY=                              # [server]  optional

# ---- App configuration ----
EMROOZ_BASE_URL=http://localhost:3005        # [public]  canonical URL, used for OG tags and mobile deep links
EMROOZ_CANONICAL_DOMAIN=emroozapp.com        # [public]
EMROOZ_DEMO_MODE=auto                        # [public]  auto | on | off. "auto" enables demo mode when Supabase envs are missing.

# ---- Backups (server-only, never bundle) ----
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=                        # [server]  age or GPG key material for at-rest encryption
