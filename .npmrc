auto-install-peers=true
strict-peer-dependencies=false
prefer-workspace-packages=true

# Expo's native-module autolinking walks require.resolve() from apps/mobile.
# pnpm's isolated store leaves transitive deps under .pnpm/, which the scanner
# can't traverse — the result is Podfile.lock silently missing native modules
# like expo-notifications, expo-linear-gradient, expo-file-system, expo-sharing.
# shamefully-hoist flattens the tree enough that autolinking finds every one.
shamefully-hoist=true
