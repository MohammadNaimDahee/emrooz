{
  "name": "@emrooz/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "android": "pnpm run prebuild:android && expo run:android",
    "ios": "pnpm run prebuild:ios && expo run:ios --no-install --no-bundler",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "echo 'No mobile tests yet — add vitest + jest-expo when the first spec lands' && exit 0",
    "prebuild": "expo prebuild && node ./scripts/strip-personal-team-entitlements.mjs",
    "prebuild:ios": "expo prebuild --platform ios && node ./scripts/strip-personal-team-entitlements.mjs",
    "prebuild:android": "expo prebuild --platform android",
    "strip-entitlements": "node ./scripts/strip-personal-team-entitlements.mjs",
    "render-icons": "node ./scripts/render-icons.mjs"
  },
  "dependencies": {
    "@emrooz/core": "workspace:*",
    "@emrooz/database": "workspace:*",
    "@emrooz/i18n": "workspace:*",
    "@emrooz/recommendations": "workspace:*",
    "@emrooz/types": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.114.0",
    "@tanstack/react-query": "^5.59.20",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-file-system": "^17.0.1",
    "expo-font": "^12.0.10",
    "expo-linear-gradient": "^13.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "^0.28.19",
    "expo-router": "~3.5.24",
    "expo-sharing": "^12.0.1",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@emrooz/config": "workspace:*",
    "@eslint/js": "^9.13.0",
    "@types/react": "~18.2.79",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0"
  }
}
