{
  "extends": "@emrooz/config/tsconfig/react-native",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["react-native", "expo-router"],
    "jsx": "react-native",
    "noEmit": true,
    "allowJs": true
  },
  "include": ["src/**/*", "app/**/*", "app.json", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
